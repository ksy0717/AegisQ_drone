# Optional local overrides for /etc/default/drone-companion.
# Keep this file root-readable only when WHIP_TOKEN is populated.

# WHIP is fail-closed and remains disabled until the server issues a stream key.
ENABLE_WHIP=0

# Use the ingest service endpoint, not the LiveKit room name:
#   http://10.100.0.1:8085/w/<server-issued-stream_key>
WHIP_URL=

# Optional bearer token. Never commit a real token or stream key.
WHIP_TOKEN=

# Restart only the isolated WHIP publisher when signalling is unavailable.
WHIP_RETRY_SECS=15

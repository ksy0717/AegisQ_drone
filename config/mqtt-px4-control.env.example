# Runtime configuration template. Copy to:
#   /etc/drone-companion/mqtt-px4-control.env
#
# Every variable below is required. The agent has no compiled fallbacks: an
# unset or empty value aborts startup with the variable's name, because a
# default vehicle limit is a vehicle policy nobody reviewed. systemd exports an
# empty EnvironmentFile entry rather than dropping it, so empty is not unset.

# Leave REMOTE_FLIGHT_EXECUTE at 0 until MQTT authentication, command/status
# round-trip, SITL, and vehicle checks have all passed. At 0 the process opens
# no MAVSDK connection and emits no MAVLink; it answers every command with a
# truthful ACCEPTED -> FAILED("remote_flight_execute_disabled") round trip.
# The FLIGHT_*, PX4_* variables are read only when this is 1.
REMOTE_FLIGHT_EXECUTE=0

# The control and RTSP server is reachable only through this WireGuard route.
WIREGUARD_INTERFACE=wg0
WIREGUARD_SERVER_IP=10.100.0.1

# The host must be an IPv4 literal equal to WIREGUARD_SERVER_IP and the port
# must be 8883; a name that resolved elsewhere would defeat the route check.
MQTT_BROKER_URI=mqtts://10.100.0.1:8883
# Both ids must name the same server-registered mobilityClass=DRONE vehicle,
# and the client certificate ACL must authorize only that vehicle's topics.
MQTT_CLIENT_ID=DRONE-01
MQTT_VEHICLE_ID=DRONE-01
# These exact topics are the AegisQ backend contract. The agent derives them
# from MQTT_VEHICLE_ID and refuses to start if these disagree.
MQTT_COMMAND_TOPIC=aegisq/cmd/DRONE-01
MQTT_COMMAND_ACK_TOPIC=aegisq/cmd-ack/DRONE-01
MQTT_QOS=1
# Dominates how fast a silently broken link is noticed: measured on the Pi, the
# detection share is about 1.5x this value (30 -> 45.2 s, 10 -> 15.3 s). Lowering
# MQTT_LINK_LOSS_TIMEOUT_S alone barely moves the total.
MQTT_KEEPALIVE_SEC=10
MQTT_RECONNECT_MIN_SEC=1
MQTT_RECONNECT_MAX_SEC=30
MQTT_CA_FILE=/etc/aegisq/certs/ca.crt
MQTT_CERT_FILE=/etc/aegisq/certs/DRONE-01.crt
# The key must be unencrypted; no passphrase callback is installed.
MQTT_KEY_FILE=/etc/aegisq/certs/DRONE-01.key

# Operational ingress bounds. The safety queue is reserved so a full mission
# queue can never block STOP/RTL/EMERGENCY_STOP.
MQTT_MAX_PAYLOAD_BYTES=65536
MQTT_COMMAND_QUEUE_CAPACITY=8
MQTT_SAFETY_QUEUE_CAPACITY=4
MQTT_MAX_ISSUED_BY_BYTES=128
MQTT_MAX_JSON_DEPTH=4
# ACK rows drained per broker round; and how long the graceful-offline LWT may
# take on shutdown.
MQTT_OUTBOX_BATCH_SIZE=16
MQTT_GRACEFUL_OFFLINE_TIMEOUT_MS=1000
# "Connected" means the broker granted a QoS 1 subscription. A broker that
# grants QoS 0 produces no error at all, so silence past this deadline is fatal.
MQTT_INITIAL_CONNECT_TIMEOUT_S=60

# A trustworthy system clock and explicit freshness policy are required before
# REMOTE_FLIGHT_EXECUTE may be enabled.
MQTT_COMMAND_MAX_AGE_SEC=300
MQTT_MAX_FUTURE_SKEW_SEC=10

# Published with the vehicle registration on every broker connect. Values with
# spaces are quoted so the file can also be sourced by a shell for testing;
# systemd strips the quotes either way.
VEHICLE_NAME="Riposte 01"
VEHICLE_MODEL=skyhunter-x
VEHICLE_FIRMWARE=px4-1.15
SITE_ID=site-01

# These values are vehicle policy and must be selected explicitly. They bound
# both decoding and dispatch; the agent uses one set for each.
ROUTE_MAX_WAYPOINTS=20
ROUTE_MIN_REL_ALT_M=2.0
ROUTE_MAX_REL_ALT_M=60.0
ROUTE_MAX_DWELL_SEC=120
ROUTE_MAX_TOTAL_DWELL_SEC=600
# Bounds for the server's cruiseSpeedMps and per-waypoint speed. The AegisQ
# console enforces 0.5-8.0 m/s; these are the airframe's own limits and a
# command outside them is rejected rather than clamped.
ROUTE_MIN_SPEED_MPS=0.5
ROUTE_MAX_SPEED_MPS=8.0

# Durable command claim and ACK outbox. The parent directory must already
# exist: the unit's StateDirectory= creates it, and the ledger does not mkdir.
# Size LEDGER_MAX_PENDING_OUTBOX with headroom for the worst-case unresolved
# set, because a full outbox at crash time blocks restart recovery.
LEDGER_DB_PATH=/var/lib/drone-companion/commands.sqlite3
LEDGER_MAX_PENDING_OUTBOX=256
LEDGER_OUTBOX_CLAIM_RESERVE=32
LEDGER_MAX_STATUS_DETAIL_BYTES=512
LEDGER_BUSY_TIMEOUT_MS=5000

# One route at a time. The terminal event capacity must be at least
# mission + safety + 1.
EXECUTOR_MISSION_QUEUE_CAPACITY=1
EXECUTOR_SAFETY_QUEUE_CAPACITY=4
EXECUTOR_TERMINAL_EVENT_CAPACITY=16

# Supervisor cadence. The shutdown watchdog force-exits if the PX4 owner wedges
# inside its safe-shutdown path; systemd Restart= is the recovery.
TELEMETRY_PUBLISH_INTERVAL_MS=1000
BATTERY_SUPERVISOR_INTERVAL_MS=2000
SHUTDOWN_WATCHDOG_S=30

# How long the broker session may stay down before an airborne vehicle returns
# on its own. PX4 keeps seeing a healthy MAVLink link to this companion, so its
# datalink failsafe never fires -- without this the aircraft would fly the rest
# of its route with nobody able to send STOP or RTL. On the ground, or with no
# valid home, the outage is logged and nothing is commanded.
# 1.5 x keepalive (15.3 s) + this = 20.3 s measured, aircraft to return.
MQTT_LINK_LOSS_TIMEOUT_S=5

# Temporary software containment, measured horizontally from PX4's home (the
# point latched at arming). Beyond this the aircraft returns on its own. This
# exists because the mission codec does not accept a geofence from the server
# yet -- it is the only containment the agent has, not a second opinion.
GEOFENCE_RADIUS_M=50

# ---------------------------------------------------------------------------
# Everything below is read only when REMOTE_FLIGHT_EXECUTE=1.
# ---------------------------------------------------------------------------

PX4_CONNECTION=serial:///dev/ttyAMA0:921600
PX4_DISCOVERY_TIMEOUT_S=15.0
# MAVSDK v3.17 defaults CompanionComputer to component 195; riposte_test pins
# 191 so ground requests addressed to 191 arrive. Keep both agents consistent.
PX4_COMPONENT_ID=191
# Neither MAVSDK class requests its own stream rates. Without these, arrival
# judgement, the takeoff-height wait and both battery gates read stale data.
PX4_RATE_POSITION_VELOCITY_NED_HZ=20.0
PX4_RATE_BATTERY_HZ=1.0
PX4_RATE_POSITION_HZ=5.0
# RC_STATUS independently proves that the receiver link is currently alive;
# cached channel PWM alone is never accepted as ownership authorization.
PX4_RATE_RC_STATUS_HZ=5.0
# Ownership is decided from PX4's raw RC_CHANNELS stream, not from flightMode.
# Failure to request this rate prevents the flight agent from starting.
PX4_RATE_RC_CHANNELS_HZ=20.0

# RC ownership switch. Defaults match a three-position CH6 ordered
# OFFBOARD / HOLD / POSITION. Measure the actual PWM values in the journal and
# adjust the non-overlapping windows per transmitter before enabling flight.
# POSITION yields to the pilot immediately. Returning to HOLD is deliberately
# debounced; a new mission is accepted only from HOLD while OnGround+DISARMED.
# OFFBOARD is reported as PI-authorized but is not a start-ready ground mode:
# the companion must prime a fresh current-position setpoint before it enters
# Offboard, so the operator should leave CH6 at HOLD and press START.
FLIGHT_OWNERSHIP_RC_CHANNEL=6
FLIGHT_OWNERSHIP_OFFBOARD_PWM_MIN=900
FLIGHT_OWNERSHIP_OFFBOARD_PWM_MAX=1100
FLIGHT_OWNERSHIP_HOLD_PWM_MIN=1400
FLIGHT_OWNERSHIP_HOLD_PWM_MAX=1600
FLIGHT_OWNERSHIP_POSITION_PWM_MIN=1900
FLIGHT_OWNERSHIP_POSITION_PWM_MAX=2100
# Physical arm switch proof for a remote ground START. PX4 armed=false remains
# authoritative; these values additionally require the transmitter's CH5 to
# be deliberately left in DISARM before the Pi may send Action::arm().
FLIGHT_ARM_SWITCH_RC_CHANNEL=5
FLIGHT_ARM_SWITCH_DISARM_PWM_MIN=900
FLIGHT_ARM_SWITCH_DISARM_PWM_MAX=1100
FLIGHT_ARM_SWITCH_ARM_PWM_MIN=1900
FLIGHT_ARM_SWITCH_ARM_PWM_MAX=2100
FLIGHT_OWNERSHIP_DEBOUNCE_MS=150
FLIGHT_OWNERSHIP_STALE_MS=500

# Offboard setpoint mechanics. These are the values verified by the Riposte
# test runner (include/riposte/test_config.hpp). FLIGHT_SETPOINT_WATCHDOG_
# TIMEOUT_S must stay above 2 / FLIGHT_SETPOINT_RATE_HZ or startup is rejected.
FLIGHT_SETPOINT_RATE_HZ=20.0
FLIGHT_SETPOINT_WATCHDOG_TIMEOUT_S=0.30
FLIGHT_SETPOINT_WATCHDOG_POLL_S=0.025
# Once generation stalls, the ordinary flight owner gets this long to perform
# its serialized cleanup. Only a genuinely stalled owner reaches the watchdog's
# independent stop+land fallback.
FLIGHT_SETPOINT_WATCHDOG_OWNER_GRACE_S=0.50
# MAVSDK's flight-mode cache is heartbeat-driven. Allow the first heartbeat
# after Offboard::start(), then treat every remaining non-Offboard mode under
# CH6 HOLD as an Offboard-loss fault rather than a pilot takeover.
FLIGHT_OFFBOARD_MODE_CONFIRMATION_S=1.50
FLIGHT_ACTION_TAKEOFF_MIN_ALTITUDE_M=2.5
FLIGHT_OFFBOARD_CLIMB_SPEED_M_S=0.5
FLIGHT_OFFBOARD_PRIME_SECONDS=1.0
FLIGHT_OFFBOARD_PRIME_RETRY_INCREMENT_S=0.35
FLIGHT_OFFBOARD_START_ATTEMPTS=3
FLIGHT_TAKEOFF_ALTITUDE_TOLERANCE_M=0.5
FLIGHT_TAKEOFF_VERTICAL_SPEED_TOLERANCE_M_S=0.5
FLIGHT_TAKEOFF_SETTLE_S=1.0
FLIGHT_TAKEOFF_TIMEOUT_S=90.0
FLIGHT_LANDING_TIMEOUT_S=90.0
FLIGHT_RTL_TIMEOUT_S=180.0
FLIGHT_COMMAND_POLL_S=0.1
FLIGHT_DISARM_TIMEOUT_S=10.0

# Route judgement tolerances and timeouts, also from the verified Riposte set.
FLIGHT_HORIZONTAL_TOLERANCE_M=0.6
FLIGHT_VERTICAL_TOLERANCE_FLOOR_M=0.30
FLIGHT_VERTICAL_TOLERANCE_RATIO=0.10
FLIGHT_ARRIVAL_SPEED_TOLERANCE_M_S=0.5
FLIGHT_ARRIVAL_SETTLE_S=1.0
FLIGHT_ARRIVAL_TIMEOUT_S=30.0
FLIGHT_HEALTH_TIMEOUT_S=60.0
FLIGHT_POSITION_TIMEOUT_S=10.0
FLIGHT_BATTERY_TELEMETRY_TIMEOUT_S=10.0

# Battery gates are fractions, not percent. The RTL threshold must be strictly
# below the preflight gate.
FLIGHT_PREFLIGHT_MIN_BATTERY_FRACTION=0.60
FLIGHT_LOW_BATTERY_RTL_FRACTION=0.30

# NOT inherited from the verified Riposte catalogue: those tests fly fixed
# short profiles and never needed a cruise speed or a launch-offset bound.
# Choose these per airframe and confirm them in SITL before flying a route.
FLIGHT_CRUISE_SPEED_M_S=3.0
FLIGHT_VERTICAL_SPEED_M_S=1.0
FLIGHT_MAX_ROUTE_RADIUS_M=60.0
FLIGHT_MAX_HOME_LAUNCH_HORIZONTAL_M=10.0
FLIGHT_MAX_HOME_LAUNCH_ALTITUDE_DELTA_M=5.0
